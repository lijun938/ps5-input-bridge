<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Offline WPF validation, using synthetic profiles and no user credential reads. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ps5Bridge.App/Ps5Bridge.App.csproj" />
  </ItemGroup>
</Project>
