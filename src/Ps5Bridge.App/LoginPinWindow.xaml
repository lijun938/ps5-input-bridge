<Window x:Class="Ps5Bridge.App.LoginPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="主机账户登录密码" Width="410" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26">
        <TextBlock Text="输入主机账户登录密码" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,15"
                   Text="此 PS5 账户启用了 4 位登录密码，请输入对应数字。密码仅用于本次连接，不保存。" />
        <PasswordBox x:Name="PinInput" MaxLength="4" Padding="10,8" FontSize="20" />
        <TextBlock x:Name="ErrorText" Text="请输入 4 位数字。" Foreground="#A03D25" Margin="0,10,0,0"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" />
            <Button x:Name="SubmitButton" Content="继续连接" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Click="Submit_Click" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
