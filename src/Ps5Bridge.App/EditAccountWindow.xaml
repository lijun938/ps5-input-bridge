<Window x:Class="Ps5Bridge.App.EditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="编辑账户" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26">
        <TextBlock Text="编辑账户" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="账户名称" Margin="0,18,0,6" />
        <TextBox x:Name="NameInput" MaxLength="80" AutomationProperties.Name="账户名称" />
        <TextBlock Style="{StaticResource Hint}" Text="名称仅用于区分账户，改名不会改变连接地址。" Margin="0,5,0,0" />
        <TextBlock Text="PS5 的局域网 IP 或主机名" Margin="0,16,0,6" />
        <TextBox x:Name="HostInput" MaxLength="253" AutomationProperties.Name="PS5 的局域网 IP 或主机名" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                   Text="地址变化可直接修改，无需重新配对。修改正在连接的账户地址会先断开，请保存后重新连接。" />
        <TextBlock x:Name="ErrorText" Foreground="#A03D25" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" />
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
