<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Ps5InputBridge</AssemblyName>
    <Version>1.1.1</Version>
    <RootNamespace>Ps5Bridge.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ps5Bridge.Core/Ps5Bridge.Core.csproj" />
    <None Include="../../native/out/ps5bridge.dll" Link="ps5bridge.dll" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../native/out/ps5bridge.dll')" />
  </ItemGroup>
  <Target Name="RequireNativeBackendForPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('../../native/out/ps5bridge.dll')" Text="Build native/out/ps5bridge.dll first with tools/build-native.ps1." />
  </Target>
</Project>
