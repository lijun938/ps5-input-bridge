<Window x:Class="Ps5Bridge.App.BundlePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="账户文件密码" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26">
        <TextBlock x:Name="HeadingText" FontSize="19" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,10,0,15" TextWrapping="Wrap" />
        <PasswordBox x:Name="PasswordInput" Padding="10,8" />
        <TextBlock x:Name="ErrorText" Text="密码至少 8 个字符。" Foreground="#A03D25" Margin="0,10,0,0"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" />
            <Button x:Name="SubmitButton" Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Click="Submit_Click" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
